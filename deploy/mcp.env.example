# Copy this file to a protected server path such as
# /etc/welding-business-service/mcp.env and fill in the values.
# Do not commit the filled file.

APP_ENV=production
APP_TIMEZONE=Asia/Shanghai
MODEL_ENABLED=false
MCP_KNOWLEDGE_TOOLS_ENABLED=false
PLATFORM_SCHEDULER_ENABLED=false
WORKSHOP_REPORT_SCHEDULE_ENABLED=false

# This deployment is an MCP tool host. It does not require PostgreSQL.
# Keep DATABASE_URL unset unless the optional backend knowledge tools are enabled.
DATABASE_URL=

# Business data is read from JianDaoYun through the configured MCP endpoint.
WORKSHOP_DATA_ADAPTER=jiandaoyun_mcp
WORKSHOP_WORK_REPORT_ADAPTER=jiandaoyun_mcp
WORKSHOP_REALTIME_QUERY_ENABLED=true
WORKSHOP_ALLOW_MOCK_IN_PRODUCTION=false
WORKSHOP_REPORT_OUTPUT_DIR=./data/generated_reports/workshop
WORKSHOP_SCHEDULED_REPORT_ENABLED=true
# JSON: robot binding key -> target WeCom chat IDs. Use welding and painting.
WORKSHOP_SCHEDULED_REPORT_TARGETS={"welding":["replace-with-welding-chat-id"],"painting":["replace-with-painting-chat-id"]}
WORKSHOP_SCHEDULED_REPORT_STATE_DIR=./data/scheduled_reports_state
WORKSHOP_SCHEDULED_REPORT_INCLUDE_ORDER=true
WORKSHOP_SCHEDULED_REPORT_INCLUDE_WORK=true
JIANDAOYUN_MCP_URL=
JIANDAOYUN_MCP_TIMEOUT_SECONDS=60
JIANDAOYUN_MAX_CONCURRENCY=3
JIANDAOYUN_REQUESTS_PER_SECOND=2
JIANDAOYUN_RETRY_MAX_ATTEMPTS=4
JIANDAOYUN_SINGLEFLIGHT_ENABLED=true
JIANDAOYUN_WORKSHOP_APP_ID=
JIANDAOYUN_WORKSHOP_ENTRY_ID=
JIANDAOYUN_WORK_REPORT_ENTRY_ID=
JIANDAOYUN_WELDING_PICK_WORK_REPORT_ENTRY_ID=

# These JSON mappings must match the live JianDaoYun field IDs used by the
# business adapter. Keep them as one-line JSON values in the real env file.
JIANDAOYUN_WORK_REPORT_FIELD_MAP={}
JIANDAOYUN_WELDING_PICK_WORK_REPORT_FIELD_MAP={}

# Production access is fail-closed. Configure WeCom directory credentials so
# requester_id/chat_id passed by Cherry or Hermes can be checked against the
# employee's real department before JianDaoYun is queried.
WECOM_REALTIME_DEPARTMENT_AUTH_ENABLED=true
WECOM_CORP_ID=
WECOM_CORP_SECRET=
WECOM_API_BASE_URL=https://qyapi.weixin.qq.com
WECOM_TIMEOUT_SECONDS=10
WORKSHOP_DEPARTMENT_ACCESS_MAP={}

# The cloud Hermes runtime owns model calls, memory, knowledge, and final text.
# These are intentionally empty in the MCP-only deployment profile.
WECOM_AGENT_MODE=hermes
HERMES_AGENT_URL=
HERMES_AGENT_API_KEY=
CHERRY_AGENT_API_URL=
CHERRY_AGENT_API_KEY=
CHERRY_AGENT_ID=
PAINTING_CHERRY_AGENT_ID=

# Scheduled delivery uses a short-lived AIBot connection only. It does not
# start a resident WeCom long-connection API process.
WECOM_AIBOT_ENABLED=false
WELDING_WECOM_AIBOT_BOT_ID=
WELDING_WECOM_AIBOT_SECRET=
WELDING_WECOM_AIBOT_WS_URL=wss://openws.work.weixin.qq.com
WELDING_WECOM_AIBOT_ENABLED=false
PAINTING_WECOM_AIBOT_BOT_ID=
PAINTING_WECOM_AIBOT_SECRET=
PAINTING_WECOM_AIBOT_WS_URL=wss://openws.work.weixin.qq.com
PAINTING_WECOM_AIBOT_ENABLED=false
GRINDING_WECOM_AIBOT_ENABLED=false
ENGRAVING_WECOM_AIBOT_ENABLED=false
