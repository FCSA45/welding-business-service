# 运行模式
APP_ENV=development
APP_TIMEZONE=Asia/Shanghai
MODEL_ENABLED=false
# Cherry/Hermes 负责知识库时保持 false；true 才会让 MCP 使用后端数据库知识库。
MCP_KNOWLEDGE_TOOLS_ENABLED=false

# 简道云
JIANDAOYUN_API_BASE_URL=https://api.jiandaoyun.com/api/v5
JIANDAOYUN_API_KEY=
JIANDAOYUN_APP_ID=
JIANDAOYUN_ENTRY_ID=
JIANDAOYUN_TIMEOUT_SECONDS=15
JIANDAOYUN_MCP_URL=
JIANDAOYUN_MCP_TIMEOUT_SECONDS=30
JIANDAOYUN_MAX_CONCURRENCY=3
JIANDAOYUN_REQUESTS_PER_SECOND=2
JIANDAOYUN_RETRY_MAX_ATTEMPTS=4
JIANDAOYUN_SINGLEFLIGHT_ENABLED=true

# 飞书

# 车间昨日数据报表（生成的 HTML/PNG 只放业务数据，不写密钥）
WORKSHOP_REPORT_OUTPUT_DIR=./data/generated_reports/workshop
REPORT_RENDERER_COMMAND=node
WORKSHOP_REPORT_RENDERER_SCRIPT=./scripts/render_report_png.mjs
WORKSHOP_REPORT_IMAGE_WIDTH=1200
WORKSHOP_REPORT_IMAGE_TIMEOUT_SECONDS=30
WORKSHOP_DATA_ADAPTER=mock
JIANDAOYUN_MCP_URL=
JIANDAOYUN_MCP_TIMEOUT_SECONDS=30
JIANDAOYUN_WORKSHOP_APP_ID=659d2050806aac7d76af53f5
JIANDAOYUN_WORKSHOP_ENTRY_ID=68301da48ef10ecd50d643b7
WORKSHOP_MOCK_DATA_PATH=./data/workshop_process_records_mock.json
WORKSHOP_ALLOW_MOCK_IN_PRODUCTION=false
WORKSHOP_REPORT_MAX_IMAGE_ROWS=100
# 测试阶段保持 false；正式启用前先完成测试群验收
WORKSHOP_REPORT_SCHEDULE_ENABLED=false
WORKSHOP_WORK_REPORT_MOCK_DATA_PATH=./data/workshop_work_reports_mock.json
# 报工数据是独立业务表；mock 或 jiandaoyun_mcp
WORKSHOP_WORK_REPORT_ADAPTER=mock
JIANDAOYUN_WORK_REPORT_ENTRY_ID=
# 完成量必须映射“总米数/总公分数”；本项目按公司口径统一视为公分，禁止用完成率反推。
JIANDAOYUN_WORK_REPORT_FIELD_MAP={"product_order_no":"","salesperson":"","workshop":"","order_date":"","delivery_date":"","product_name":"","product_quantity":"","planned_quantity":"","completed_quantity":"","quantity_unit":"","color":"","process_name":"","process_status":"","scheduled_at":"","report_department":"","reportable_process":"","reporter_name":"","reported_at":"","completion_rate":"","remark":""}
# 焊接部额外合并“抽单工序—报工”；其他部门不读取该表。
JIANDAOYUN_WELDING_PICK_WORK_REPORT_ENTRY_ID=
JIANDAOYUN_WELDING_PICK_WORK_REPORT_FIELD_MAP={"product_order_no":"","order_date":"","delivery_date":"","product_name":"","product_quantity":"","planned_quantity":"","completed_quantity":"","color":"","process_name":"","process_status":"","report_department":"","reporter_name":"","reported_at":"","completion_rate":"","remark":""}
WORKSHOP_REPORT_DEPARTMENT=霓虹部
WORKSHOP_DEPARTMENT_ACCESS_MAP={"user-id":["霓虹部"],"chat:group-id":["包装部"]}
# true：每次请求实时查询简道云/MES，不读取或写入本地业务快照
WORKSHOP_REALTIME_QUERY_ENABLED=true
WORKSHOP_EXCEL_MAX_CONCURRENCY=3
WORKSHOP_PNG_MAX_CONCURRENCY=1
WORKSHOP_CARD_ITEM_LIMIT=5

# 轻量 RAG demo（首次使用会下载约 90 MB 中文 ONNX 向量模型）
RAG_EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
RAG_MODEL_CACHE_DIR=./data/models/fastembed
RAG_CHUNK_SIZE=450
RAG_CHUNK_OVERLAP=80
RAG_MINIMUM_SCORE=0.35
RAG_MAX_UPLOAD_BYTES=10485760
RAG_ENABLED=false

# 提示词和回答硬预算，防止多轮会话与知识片段撑爆上下文
MODEL_PROMPT_TOKEN_BUDGET=6000
MODEL_COMPLETION_TOKEN_BUDGET=1000

# 大模型
MODEL_BASE_URL=
MODEL_API_KEY=
MODEL_NAME=
MODEL_ENABLED=false
WECOM_AGENT_MODE=cherry_local
CHERRY_AGENT_API_URL=http://127.0.0.1:24333
CHERRY_AGENT_API_KEY=
CHERRY_AGENT_ID=
PAINTING_CHERRY_AGENT_ID=
CHERRY_AGENT_TIMEOUT_SECONDS=120
CHERRY_AGENT_DEFAULT_SESSION_ID=
HERMES_AGENT_URL=
HERMES_AGENT_API_KEY=
HERMES_AGENT_TIMEOUT_SECONDS=60
MODEL_RETRY_MAX_ATTEMPTS=2
MODEL_TIMEOUT_SECONDS=20

# 数据库
DATABASE_URL=postgresql+psycopg://用户名:密码@localhost:5432/数据库名

# 系统安全
PLATFORM_ADMIN_API_KEY=
BUSINESS_API_KEY=

# 企业微信连接层（回调密钥与应用密钥不会写入日志）
WECOM_CORP_ID=
WECOM_CORP_SECRET=
WECOM_AGENT_ID=
WECOM_CALLBACK_TOKEN=
WECOM_ENCODING_AES_KEY=
# 状态/主动推送接口的第二道鉴权，与 BUSINESS_API_KEY 使用不同随机值
WECOM_CONNECTION_API_KEY=
WECOM_API_BASE_URL=https://qyapi.weixin.qq.com
WECOM_REALTIME_DEPARTMENT_AUTH_ENABLED=true
WECOM_AIBOT_BOT_ID=
WECOM_AIBOT_SECRET=
WECOM_AIBOT_WS_URL=wss://openws.work.weixin.qq.com
WECOM_AIBOT_ENABLED=true

# 打磨部专属机器人：凭据与包装部机器人隔离；开通前保持 false
GRINDING_WECOM_AIBOT_BOT_ID=
GRINDING_WECOM_AIBOT_SECRET=
GRINDING_WECOM_AIBOT_WS_URL=wss://openws.work.weixin.qq.com
GRINDING_WECOM_AIBOT_ENABLED=false

# 焊接部专属机器人：凭据与其他部门隔离；部署前保持 false
WELDING_WECOM_AIBOT_BOT_ID=
WELDING_WECOM_AIBOT_SECRET=
WELDING_WECOM_AIBOT_WS_URL=wss://openws.work.weixin.qq.com
WELDING_WECOM_AIBOT_ENABLED=false

# 雕刻部专属机器人：凭据与其他部门隔离；部署前保持 false
ENGRAVING_WECOM_AIBOT_BOT_ID=
ENGRAVING_WECOM_AIBOT_SECRET=
ENGRAVING_WECOM_AIBOT_WS_URL=wss://openws.work.weixin.qq.com
ENGRAVING_WECOM_AIBOT_ENABLED=false

# Oil-paint department bot. Keep disabled until the bot and directory authorization are verified.
PAINTING_WECOM_AIBOT_BOT_ID=
PAINTING_WECOM_AIBOT_SECRET=
PAINTING_WECOM_AIBOT_WS_URL=wss://openws.work.weixin.qq.com
PAINTING_WECOM_AIBOT_ENABLED=false
